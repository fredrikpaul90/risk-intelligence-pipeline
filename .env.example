# Google Cloud project hosting Document AI and Vertex AI. Copy this file to .env.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=eu
# In Google Cloud Console: Document AI > Processors > your OCR processor > Processor ID.
DOCUMENT_AI_OCR_PROCESSOR_ID=

# Vertex AI global endpoint and Gemini model used for risk extraction.
VERTEX_AI_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TEMPERATURE=0
GEMINI_SEED=0

# Local Application Default Credentials for the Google Cloud clients.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
